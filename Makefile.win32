APPVER = 5.0
TARGETOS = WINNT

!include <win32.mak>

!ifndef nounicode
cvarsdll = $(cvarsdll) -DUNICODE -D_UNICODE
!endif

!ifdef SDL2DIR
!ifndef SDL2_LIBDIR
SDL2_LIBDIR = $(SDL2DIR)\lib\x86
!endif
cvarsdll = $(cvarsdll) -DHAVE_SDL2 /I"$(SDL2DIR)\include\SDL2"
conlibsdll = $(conlibsdll) /LIBPATH:"$(SDL2_LIBDIR)" SDL2.lib
!endif

OUTDIR=.\bin\win32
TARGET=$(OUTDIR)\cbmbasic.exe

build: "$(OUTDIR)" "$(TARGET)"
rebuild: clean build
clean:
	-erase /f /q "$(OUTDIR)\*.*"
	-rmdir "$(OUTDIR)"

.c{$(OUTDIR)}.obj:
	$(cc) $(cdebug) $(cflags) $(cvarsdll) -D_CRT_SECURE_NO_DEPRECATE=1 -D_CRT_NONSTDC_NO_DEPRECATE=1 /Fo"$(OUTDIR)/" /Fd"$(OUTDIR)/" $<

"$(OUTDIR)":
	mkdir "$(OUTDIR)"

"$(TARGET)": "$(OUTDIR)\cbmbasic.obj" "$(OUTDIR)\runtime.obj" "$(OUTDIR)\readdir.obj" "$(OUTDIR)\plugin.obj" "$(OUTDIR)\console.obj" "$(OUTDIR)\sdl_ui.obj"
	$(link) $(ldebug) $(conlflags) -out:"$(TARGET)" $** $(conlibsdll)
