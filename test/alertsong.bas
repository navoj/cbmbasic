10 REM ========================================
20 REM ALERT DRIVE - FIVE SOUND HAND BASIC SONG
30 REM USES ONLY THE BUILT-IN ALERT SOUNDS 1-5
40 REM FIXED ALERTS MAKE A RHYTHM, NOT TRUE NOTES
50 REM PRESS THE BREAK BUTTON TO STOP
60 REM ========================================
70 PRINT CHR$(147)
80 PRINT "ALERT DRIVE"
90 PRINT "FIVE-SOUND SYNTHWAVE RHYTHM"
100 PRINT
110 T=90
120 RESTORE
130 READ S,D
140 IF S=-1 THEN 250
150 IF S=0 THEN 210
160 PRINT MID$("12345",S,1);
170 ALERT S
180 GOTO 220
210 PRINT ".";
220 SLEEP T*D
230 GOTO 130
250 PRINT
260 PRINT
270 PRINT "FINALE"
280 FOR S=1 TO 5
290 PRINT S;
300 ALERT S
310 SLEEP T*2
320 NEXT S
330 PRINT
340 PRINT "THANKS FOR LISTENING"
350 END
1000 REM INTRO
1010 DATA 1,4,0,2,2,2,0,2,3,2,0,2,4,2,5,4
1020 REM VERSE
1030 DATA 1,2,1,2,3,2,1,2,2,2,1,2,4,2,2,2
1040 DATA 1,2,1,2,3,2,5,2,2,2,4,2,3,2,2,4
1050 REM CHORUS
1060 DATA 5,2,3,2,4,2,2,2,5,2,3,2,4,2,1,4
1070 DATA 5,2,4,2,3,2,2,2,5,2,4,2,3,2,1,4
1080 REM BRIDGE - CLIMB AND FALL
1090 DATA 1,2,2,2,3,2,4,2,5,4,4,2,3,2,2,2,1,4
1100 REM OUTRO
1110 DATA 1,2,3,2,5,2,2,2,4,2,3,2,5,2,1,4
1120 DATA -1,0

