10 REM *** SVG5.BAS ***
20 REM *** CLOSED PATH VECTOR RASTERIZER ***
30 REM *** SCANLINE POLYGON FILL ***
40 SCREEN 2:CLS:ANTIALIAS 1
50 TITLE "VECTOR ENGINE V5 - SCANLINE FILLS"
60 DIM VX(500),VY(500),IX(500)
70 N=0:C=0:F=1:W=2
80 READ A$
90 IF A$="END" THEN900
100 IF A$="BP" THEN200
110 IF A$="M" THEN250
120 IF A$="L" THEN300
130 IF A$="Q" THEN350
140 IF A$="C" THEN450
150 IF A$="CP" THEN550
160 IF A$="FP" THEN600
170 IF A$="SP" THEN700
180 IF A$="P" THEN750
190 IF A$="F" THEN780
195 IF A$="W" THEN810
197 GOTO80

200 REM *** BEGIN PATH ***
210 N=0
220 GOTO80

250 REM *** MOVE ***
260 READ X,Y
270 N=N+1:VX(N)=X:VY(N)=Y
280 SX=X:SY=Y
290 GOTO80

300 REM *** LINE ***
310 READ X,Y
320 N=N+1:VX(N)=X:VY(N)=Y
330 GOTO80

350 REM *** QUADRATIC CURVE ***
360 READ X1,Y1,X2,Y2
370 X0=VX(N):Y0=VY(N)
380 FOR I=1 TO 24
390 T=I/24:U=1-T
400 X=U*U*X0+2*U*T*X1+T*T*X2
410 Y=U*U*Y0+2*U*T*Y1+T*T*Y2
420 N=N+1:VX(N)=X:VY(N)=Y
430 NEXT I
440 GOTO80

450 REM *** CUBIC CURVE ***
460 READ X1,Y1,X2,Y2,X3,Y3
470 X0=VX(N):Y0=VY(N)
480 FOR I=1 TO 32
490 T=I/32:U=1-T
500 X=U*U*U*X0+3*U*U*T*X1+3*U*T*T*X2+T*T*T*X3
510 Y=U*U*U*Y0+3*U*U*T*Y1+3*U*T*T*Y2+T*T*T*Y3
520 N=N+1:VX(N)=X:VY(N)=Y
530 NEXT I
540 GOTO80

550 REM *** CLOSE PATH ***
560 IF N<2 THEN80
570 N=N+1
580 VX(N)=VX(1):VY(N)=VY(1)
590 GOTO80

600 REM *** FILL PATH ***
610 IF N<3 THEN80
620 MN=799:MX=0
630 FOR I=1 TO N
640 IF VY(I)<MN THEN MN=VY(I)
650 IF VY(I)>MX THEN MX=VY(I)
660 NEXT I
670 MN=INT(MN):MX=INT(MX)
680 IF MN<0 THEN MN=0
690 IF MX>799 THEN MX=799
695 GOSUB1000
697 GOTO80

700 REM *** STROKE PATH ***
710 IF N<2 THEN80
720 LSET W,1
730 FOR I=1 TO N-1
735 LINE VX(I),VY(I),VX(I+1),VY(I+1),C
740 NEXT I
745 GOTO80

750 REM *** PEN COLOR ***
760 READ C
770 GOTO80

780 REM *** FILL COLOR ***
790 READ F
800 GOTO80

810 REM *** LINE WIDTH ***
820 READ W
830 GOTO80

900 REM *** WAIT FOR TAP ***
910 POKE1024,0
920 IF PEEK(1024)=0 THEN920
930 SCREEN 0
940 END

1000 REM =================================
1010 REM *** SCANLINE POLYGON FILL ***
1020 REM =================================
1030 FOR YY=MN TO MX
1040 K=0
1050 FOR I=1 TO N-1
1060 YA=VY(I):YB=VY(I+1)
1070 IF YA=YB THEN1140
1080 IF YY<YA AND YY<YB THEN1140
1090 IF YY>=YA AND YY>=YB THEN1140
1100 XA=VX(I):XB=VX(I+1)
1110 XX=XA+(YY-YA)*(XB-XA)/(YB-YA)
1120 K=K+1:IX(K)=XX
1140 NEXT I
1150 IF K<2 THEN1270

1160 REM *** SORT INTERSECTIONS ***
1170 FOR I=1 TO K-1
1180 FOR J=I+1 TO K
1190 IF IX(I)<=IX(J) THEN1230
1200 Z=IX(I)
1210 IX(I)=IX(J)
1220 IX(J)=Z
1230 NEXT J
1240 NEXT I

1250 REM *** DRAW PAIRS ***
1255 FOR I=1 TO K-1 STEP 2
1260 LINE INT(IX(I)),YY,INT(IX(I+1)),YY,F
1265 NEXT I

1270 NEXT YY
1280 RETURN

