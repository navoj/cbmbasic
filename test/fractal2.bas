10 REM *** FRACTL.BAS - CBM HAND BASIC ***
11 REM *** SCREEN 2 - 1600 X 800 LANDSCAPE ***
12 REM *** 1 GASKET 2 CARPET 3 FERN 4 PENT ***
20 SCREEN 2:CLS:ANTIALIAS 0:M=1:GOTO100
30 GET K$:IF K$="" THEN RETURN
40 IF K$="Q" THEN SCREEN 0:END
50 IF K$="C" THEN CLS:GOTO80
60 N=VAL(K$):IF N<1 OR N>4 THEN RETURN
70 M=N:CLS
80 ON M GOTO100,200,300,500

100 REM *** SIERPINSKI GASKET ***
101 TITLE "1 GASKET  2 CARPET  3 FERN  4 PENT"
102 X=800:Y=430
110 GOSUB30:IF M<>1 THEN80
120 R=INT(RND(1)*3):A=430:B=750
130 IF R=0 THEN A=800:B=120
140 IF R=2 THEN A=1170
150 X=(X+A)/2:Y=(Y+B)/2
160 PSET INT(X),INT(Y),5
170 GOTO110

200 REM *** SIERPINSKI CARPET ***
201 TITLE "SIERPINSKI CARPET"
202 X=800:Y=435
210 GOSUB30:IF M<>2 THEN80
220 R=INT(RND(1)*8)
230 IF R>3 THEN R=R+1
240 A=R-INT(R/3)*3:B=INT(R/3)
250 X=475+((X-475)+A*650)/3
260 Y=110+((Y-110)+B*650)/3
270 H=INT(X):V=INT(Y)
280 PSET H,V,2
290 GOTO210

300 REM *** BARNSLEY FERN ***
301 TITLE "BARNSLEY FERN"
302 X=0:Y=0
310 GOSUB30:IF M<>3 THEN80
320 R=RND(1)
330 IF R<.01 THEN A=0:B=.16*Y:GOTO370
340 IF R<.86 THEN A=.85*X+.04*Y:B=-.04*X+.85*Y+1.6:GOTO370
350 IF R<.93 THEN A=.2*X-.26*Y:B=.23*X+.22*Y+1.6:GOTO370
360 A=-.15*X+.28*Y:B=.26*X+.24*Y+.44
370 X=A:Y=B
380 H=INT(800+X*65):V=760-INT(Y*63)
390 IF H<0 OR H>=1600 OR V<0 OR V>=800 THEN410
400 PSET H,V,4
410 GOTO310

500 REM *** PENTAGON FRACTAL ***
501 TITLE "PENTAGON FRACTAL"
502 X=800:Y=435
510 GOSUB30:IF M<>4 THEN80
520 R=INT(RND(1)*5)
530 A=800+315*SIN(R*1.256637)
540 B=435-300*COS(R*1.256637)
550 X=X+.618034*(A-X)
560 Y=Y+.618034*(B-Y)
570 H=INT(X):V=INT(Y)
580 IF H<0 OR H>=1600 OR V<0 OR V>=800 THEN600
590 PSET H,V,7
600 GOTO510
