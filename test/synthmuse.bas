10 REM ========================================
20 REM SYNTHMUSE - FIVE-SOUND SYNTHWAVE LOOP
30 REM BUILT ENTIRELY WITH ALERT SOUNDS 1-5
40 REM ========================================
50 PRINT CHR$(147)
60 PRINT "SYNTHMUSE"
70 PRINT "SYNTHWAVE LOOP"
80 PRINT
90 T=110
100 RESTORE
110 READ S,D
120 IF S=-1 THEN 240
130 IF S=0 THEN 200
140 PRINT MID$("12345",S,1);
150 ALERT S
160 GOTO 210
200 PRINT ".";
210 SLEEP T*D
220 GOTO 110
240 PRINT
250 PRINT "LOOP COMPLETE"
260 END
1000 REM MAIN MELODY
1010 DATA 1,2,3,1,5,2,4,1,3,2,2,1,1,2,2,2
1020 DATA 5,2,4,2,3,2,2,2,1,2,3,1,4,2,5,4
1030 DATA 2,1,3,1,5,2,4,2,3,2,1,2,2,2,5,4
1040 DATA 1,2,2,1,3,2,5,2,4,2,2,2,1,2,3,4
1050 DATA 5,2,4,2,3,2,2,2,1,2,5,2,3,2,1,4
1060 DATA -1,0
