5 SYS 1
10 REM PORTRT10.BAS - CBM HAND BASIC
15 REM REVISION 10.1 - FRAME COMMANDS ON THEIR OWN LINES
20 REM ORIGINAL RGB PIXELS FROM THE ATTACHED PORTRAIT
30 REM KEEP PORTRT10.DAT IN THE SAME BASIC DIRECTORY
40 REM MODE 1 PRESERVES SOURCE PIXELS; MODE 2 RESIZES
50 REM SET DEVICE ORIENTATION BEFORE RUNNING
60 DEF FN PK(A)=PEEK(A)+256*PEEK(A+1)
70 MD=FN PK(1042)
80 IF MD<1 OR MD>3 THEN MD=2
90 SCREEN MD
100 SW=MD*FN PK(1038):SH=MD*FN PK(1040)
110 IF SW<1 OR SH<1 THEN 8000
120 IW=1536:IH=1024
130 SCREEN 0:CLS
140 PRINT "PORTRAIT - ORIGINAL RGB IMAGE"
150 PRINT "SOURCE: 1536 X 1024 PIXELS"
160 PRINT "GRAPHICS CANVAS:";SW;"X";SH
170 PRINT
180 PRINT "1 - ORIGINAL PIXELS (NO RESIZING)"
190 PRINT "2 - FIT WHOLE IMAGE (RESIZED IF NEEDED)"
200 PRINT "0 - QUIT"
210 INPUT "DISPLAY MODE";VM
220 IF VM=0 THEN 7900
230 IF VM<>1 AND VM<>2 THEN 210
240 PX=0:PY=0
250 IF VM=2 THEN 310
260 IF SW>=IW AND SH>=IH THEN 310
270 PRINT "THIS SCREEN SHOWS A PART OF THE ORIGINAL."
280 PRINT "ENTER THE SOURCE UPPER-LEFT PIXEL X,Y."
290 PRINT "USE 0,0 TO START AT THE UPPER LEFT."
300 INPUT PX,PY
310 MX=IW-SW:MY=IH-SH
320 IF MX<0 THEN MX=0
330 IF MY<0 THEN MY=0
340 PX=INT(PX):PY=INT(PY)
350 IF PX<0 THEN PX=0
360 IF PY<0 THEN PY=0
370 IF PX>MX THEN PX=MX
380 IF PY>MY THEN PY=MY
390 DW=IW:DH=IH
400 IF VM=1 THEN 470
410 REM INTEGER DIMENSIONS KEEP THE EXACT 3:2 ASPECT RATIO
420 UA=INT(SW/3)
430 IF INT(SH/2)<UA THEN UA=INT(SH/2)
440 IF UA>512 THEN UA=512
450 IF UA<1 THEN 8000
460 DW=3*UA:DH=2*UA
470 OX=INT((SW-DW)/2):OY=INT((SH-DH)/2)
480 IF SW<DW THEN OX=-PX
490 IF SH<DH THEN OY=-PY
500 OPEN 1,0,0,"PORTRT10.DAT"
510 BF=0:INPUT#1,FM,FW,FH
520 IF ST<>0 THEN 9000
530 IF FM<>10 OR FW<>IW OR FH<>IH THEN 9000
540 SCREEN MD:CLS
550 TITLE "PORTRAIT - DRAWING; TAP TO CANCEL"
555 REM RESET GLOBAL DRAWING STYLE BEFORE SETTING ANY PIXELS
560 ANTIALIAS 0:LSET 1,0
570 CSET 17,246,240,228,255
580 RECT 0,0,SW,SH,17
590 POKE 1024,0:RC=0
600 FOR Y=0 TO IH-1
610 X=0
620 REM MAP PIXEL CENTERS; BOTH RIGHT EDGES ARE EXCLUSIVE
630 Y1=OY-INT(.5-Y*DH/IH)
640 Y2=OY-INT(.5-(Y+1)*DH/IH)
650 IF Y1<0 THEN Y1=0
660 IF Y2>SH THEN Y2=SH
670 VF=0
680 IF Y2>Y1 AND Y2>0 AND Y1<SH THEN VF=1
690 IF VF=0 THEN 700
691 BEGINFRAME
692 BF=1
700 INPUT#1,N,R,G,B
710 IF ST<>0 THEN 9000
720 IF N<1 OR N<>INT(N) OR X+N>IW THEN 9000
730 IF R<0 OR R>255 OR G<0 OR G>255 THEN 9000
740 IF B<0 OR B>255 THEN 9000
750 IF R<>INT(R) OR G<>INT(G) OR B<>INT(B) THEN 9000
760 IF VF=0 THEN 860
770 X1=OX-INT(.5-X*DW/IW)
780 X2=OX-INT(.5-(X+N)*DW/IW)
790 IF X1<0 THEN X1=0
800 IF X2>SW THEN X2=SW
810 IF X2<=X1 THEN 860
820 REM ONE REUSABLE DIRECT RGB COLOR; NO INDEXED PALETTE LOSS
830 CSET 16,R,G,B,255
840 FOR XX=X1 TO X2-1
845 PSET XX,Y1,16
850 NEXT XX
860 X=X+N:RC=RC+1
870 IF X<IW THEN 700
880 IF BF=0 THEN 890
881 ENDFRAME
882 BF=0
890 IF PEEK(1024)<>0 THEN 9100
900 NEXT Y
910 INPUT#1,N,R,G,B
920 IF N<>0 OR R<>0 OR G<>0 OR B<>0 THEN 9000
930 IF RC<>962522 THEN 9000
940 CLOSE 1
950 TITLE "PORTRAIT - TAP FOR MENU"
960 POKE 1024,0
970 SLEEP 50:GET A$
980 IF A$="Q" OR A$="q" THEN 7900
990 IF PEEK(1024)=0 AND A$="" THEN 970
1000 GOTO 130
7900 SCREEN 0:END
8000 SCREEN 0:CLS
8010 PRINT "SCREEN SIZE IS UNAVAILABLE OR TOO SMALL."
8020 PRINT "THIS PROGRAM NEEDS CBM HAND BASIC 1.7.5 OR LATER."
8030 END
9000 IF BF=0 THEN 9010
9001 ENDFRAME
9010 CLOSE 1:SCREEN 0:CLS
9020 PRINT "PORTRT10.DAT IS INVALID OR INCOMPLETE."
9030 PRINT "SOURCE ROW:";Y;" SOURCE COLUMN:";X
9040 PRINT "IMPORT THE ORIGINAL DATA FILE AGAIN."
9050 END
9100 CLOSE 1:GOTO 130
